---
import '../styles/cursor.css';
---
<script>
  import type MouseFollower from 'mouse-follower';

  const eligible = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  let cursors: MouseFollower[] = [];
  let revision = 0;
  let stopTweens: (() => void) | undefined;
  let stopTrail: (() => void) | undefined;

  function dispose() {
    revision++;
    stopTrail?.();
    stopTrail = undefined;
    stopTweens?.();
    stopTweens = undefined;
    cursors.forEach((cursor) => cursor.destroy());
    cursors = [];
  }

  async function syncCursor() {
    dispose();
    if (!eligible.matches || document.hidden) return;
    const current = revision;
    try {
      const [{ default: Follower }, { gsap }] = await Promise.all([
        import('mouse-follower'), import('gsap'),
      ]);
      if (current !== revision || !eligible.matches || document.hidden) return;
      Follower.registerGSAP(gsap);
      // v1.2.1 skips rendering if either velocity axis is zero. Pure horizontal
      // or vertical mouse movement must still update the follower position.
      class OpticalFollower extends Follower {
        render(force = false) { super.render(force || this.vel.x !== 0 || this.vel.y !== 0); }
      }
        const cursor = new OpticalFollower({
          className: 'optical-cursor', speed: 0.08, skewing: 0,
          dataAttr: null, hideTimeout: 120,
          stateDetection: {
            '-pointer': 'a, button, [role="button"]',
            '-hidden': 'input, textarea, select, [contenteditable], iframe',
          },
        });
        cursor.el.setAttribute('aria-hidden', 'true');
        cursors.push(cursor);
      const canvas = document.createElement('canvas');
      canvas.className = 'comet-trail';
      canvas.setAttribute('aria-hidden', 'true');
      document.body.appendChild(canvas);
      const context = canvas.getContext('2d');
      let frame = 0;
      let points: { x: number; y: number; time: number }[] = [];
      let lastMove = -Infinity;
      const lifetime = 360;
      const resize = () => {
        const ratio = Math.min(devicePixelRatio || 1, 1.5);
        canvas.width = Math.round(innerWidth * ratio);
        canvas.height = Math.round(innerHeight * ratio);
        context?.setTransform(ratio, 0, 0, ratio, 0, 0);
        points = [];
      };
      const draw = (time: number) => {
        frame = 0;
        if (!context) return;
        context.clearRect(0, 0, innerWidth, innerHeight);
        const hidden = cursor.el.classList.contains('-hidden');
        const hovering = cursor.el.classList.contains('-pointer');
        points = points.filter(point => time - point.time < lifetime);
        if (hidden || hovering) points = [];
        else if (time - lastMove < 140) {
          const previous = points.at(-1);
          if (!previous || Math.hypot(cursor.pos.x - previous.x, cursor.pos.y - previous.y) > 0.5) {
            points.push({ x: cursor.pos.x, y: cursor.pos.y, time });
            if (points.length > 64) points.shift();
          }
        }
        context.lineCap = 'round';
        for (let i = 1; i < points.length; i++) {
          const a = points[i - 1];
          const b = points[i];
          const freshness = 1 - (time - a.time) / lifetime;
          // Time-based history naturally leaves a longer wake at higher speed.
          context.strokeStyle = `hsla(${265 - freshness * 50}, 95%, ${60 + freshness * 20}%, ${freshness * 0.75})`;
          context.lineWidth = 0.5 + freshness * 2;
          context.shadowColor = '#797bff';
          context.shadowBlur = 9 * freshness;
          context.beginPath();
          context.moveTo(a.x, a.y);
          context.lineTo(b.x, b.y);
          context.stroke();
        }
        if (points.length || time - lastMove < lifetime) frame = requestAnimationFrame(draw);
      };
      const move = () => {
        lastMove = performance.now();
        if (!frame) frame = requestAnimationFrame(draw);
      };
      const clear = () => {
        points = [];
        lastMove = -Infinity;
        cancelAnimationFrame(frame);
        frame = 0;
        context?.clearRect(0, 0, innerWidth, innerHeight);
      };
      resize();
      document.documentElement.addEventListener('mousemove', move, { passive: true });
      document.documentElement.addEventListener('mouseleave', clear);
      window.addEventListener('resize', resize);
      stopTrail = () => {
        clear();
        canvas.remove();
        document.documentElement.removeEventListener('mousemove', move);
        document.documentElement.removeEventListener('mouseleave', clear);
        window.removeEventListener('resize', resize);
      };
      stopTweens = () => cursors.forEach((cursor) => gsap.killTweensOf(cursor.pos));
    } catch {
      // Decoration must never prevent navigation or remove the native cursor.
      dispose();
    }
  }

  eligible.addEventListener('change', syncCursor);
  document.addEventListener('visibilitychange', syncCursor);
  document.addEventListener('astro:before-swap', dispose);
  document.addEventListener('astro:page-load', syncCursor);
  window.addEventListener('pagehide', dispose);
  window.addEventListener('pageshow', syncCursor);
  void syncCursor();
</script>
