<div class="cosmic-backdrop" data-cosmic-backdrop aria-hidden="true">
  <div class="aurora aurora-primary"></div>
  <div class="aurora aurora-secondary"></div>
  <canvas data-meteor-field></canvas>
</div>

<script>
  const backdrop = document.querySelector<HTMLElement>('[data-cosmic-backdrop]');
  const canvas = backdrop?.querySelector<HTMLCanvasElement>('[data-meteor-field]');

  if (backdrop && canvas && !backdrop.dataset.ready) {
    backdrop.dataset.ready = 'true';
    const context = canvas.getContext('2d');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const compactScreen = window.matchMedia('(max-width: 720px)');
    let width = 0;
    let height = 0;
    let frame = 0;
    let lastTime = 0;
    let nextMeteorAt = 0;
    let pointerX = 0;
    let pointerY = 0;
    let targetX = 0;
    let targetY = 0;

    type Star = { x: number; y: number; radius: number; depth: number; alpha: number; phase: number };
    type Meteor = { x: number; y: number; length: number; speed: number; life: number; maxLife: number };

    let stars: Star[] = [];
    const meteors: Meteor[] = [];

    const createStars = () => {
      const count = compactScreen.matches ? 22 : Math.min(58, Math.round((width * height) / 26000));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        radius: Math.random() * 1.15 + 0.25,
        depth: Math.random() * 0.8 + 0.2,
        alpha: Math.random() * 0.42 + 0.16,
        phase: Math.random() * Math.PI * 2,
      }));
    };

    const resize = () => {
      if (!context) return;
      const ratio = Math.min(window.devicePixelRatio || 1, 1.75);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      createStars();
    };

    const addMeteor = () => {
      const maxLife = 900 + Math.random() * 500;
      meteors.push({
        x: width * (0.22 + Math.random() * 0.72),
        y: -40 - Math.random() * 100,
        length: 55 + Math.random() * 75,
        speed: 0.25 + Math.random() * 0.16,
        life: maxLife,
        maxLife,
      });
    };

    const draw = (time = 0) => {
      if (!context) return;
      const delta = Math.min(time - lastTime || 16, 34);
      lastTime = time;
      pointerX += (targetX - pointerX) * 0.035;
      pointerY += (targetY - pointerY) * 0.035;
      context.clearRect(0, 0, width, height);

      for (const star of stars) {
        const shimmer = reducedMotion.matches ? 1 : 0.72 + Math.sin(time * 0.0008 + star.phase) * 0.28;
        const x = star.x + pointerX * star.depth * 15;
        const y = star.y + pointerY * star.depth * 10;
        context.beginPath();
        context.fillStyle = `rgba(159, 235, 255, ${star.alpha * shimmer})`;
        context.arc(x, y, star.radius, 0, Math.PI * 2);
        context.fill();
      }

      if (!reducedMotion.matches && !compactScreen.matches && time >= nextMeteorAt) {
        addMeteor();
        nextMeteorAt = time + 2600 + Math.random() * 4200;
      }

      for (let index = meteors.length - 1; index >= 0; index -= 1) {
        const meteor = meteors[index];
        meteor.x -= delta * meteor.speed;
        meteor.y += delta * meteor.speed * 0.62;
        meteor.life -= delta;
        const opacity = Math.sin((meteor.life / meteor.maxLife) * Math.PI) * 0.5;
        const gradient = context.createLinearGradient(
          meteor.x,
          meteor.y,
          meteor.x + meteor.length,
          meteor.y - meteor.length * 0.62,
        );
        gradient.addColorStop(0, `rgba(175, 246, 255, ${opacity})`);
        gradient.addColorStop(1, 'rgba(100, 230, 255, 0)');
        context.beginPath();
        context.strokeStyle = gradient;
        context.lineWidth = 1;
        context.moveTo(meteor.x, meteor.y);
        context.lineTo(meteor.x + meteor.length, meteor.y - meteor.length * 0.62);
        context.stroke();
        if (meteor.life <= 0) meteors.splice(index, 1);
      }

      if (!reducedMotion.matches && !document.hidden) frame = requestAnimationFrame(draw);
    };

    const start = () => {
      cancelAnimationFrame(frame);
      lastTime = 0;
      if (reducedMotion.matches) draw();
      else frame = requestAnimationFrame(draw);
    };

    const updatePointer = (event: PointerEvent) => {
      targetX = event.clientX / width - 0.5;
      targetY = event.clientY / height - 0.5;
      backdrop.style.setProperty('--pointer-x', `${targetX * 12}px`);
      backdrop.style.setProperty('--pointer-y', `${targetY * 8}px`);
      backdrop.style.setProperty('--pointer-x-reverse', `${targetX * -7.2}px`);
      backdrop.style.setProperty('--pointer-y-reverse', `${targetY * -4.8}px`);
    };

    const handleVisibility = () => {
      if (document.hidden) cancelAnimationFrame(frame);
      else start();
    };

    resize();
    start();
    window.addEventListener('resize', resize, { passive: true });
    if (!compactScreen.matches) window.addEventListener('pointermove', updatePointer, { passive: true });
    document.addEventListener('visibilitychange', handleVisibility);
    reducedMotion.addEventListener('change', start);
  }
</script>
