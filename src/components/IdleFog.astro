<div class="idle-fog" data-idle-fog aria-hidden="true"></div>

<style>
  .idle-fog {
    position: fixed;
    top: var(--fog-y, 50%);
    left: var(--fog-x, 50%);
    width: 124px;
    height: 94px;
    z-index: 8;
    pointer-events: none;
    opacity: 0;
    border-radius: 44% 56% 54% 46% / 54% 42% 58% 46%;
    transform: translate(-50%, -50%) scale(0.84);
    background:
      radial-gradient(ellipse at 25% 12%, rgb(234 255 252 / 22%), transparent 38%),
      linear-gradient(155deg, rgb(210 255 248 / 12%), transparent 48%, rgb(108 195 186 / 12%));
    backdrop-filter: blur(3px) saturate(1.55) contrast(1.08);
    box-shadow:
      inset 1px 1px 1px rgb(233 255 250 / 54%),
      inset -1px -2px 2px rgb(192 255 245 / 21%),
      inset 0 0 14px rgb(194 255 247 / 13%),
      0 5px 16px rgb(0 0 0 / 32%);
    transition: opacity 150ms ease-out, transform 150ms ease-out;
  }

  .idle-fog.is-visible {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    transition-duration: 270ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .idle-fog { display: none; }
  }
</style>

<script>
  const fog = document.querySelector<HTMLElement>('[data-idle-fog]');
  const mouse = matchMedia('(any-hover: hover) and (any-pointer: fine)');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let timer: ReturnType<typeof setTimeout> | undefined;

  function clearFog() {
    clearTimeout(timer);
    fog?.classList.remove('is-visible');
  }

  function waitForIdle(event: PointerEvent) {
    clearFog();
    if (!fog || event.pointerType !== 'mouse' || event.buttons || !mouse.matches ||
      reducedMotion.matches || document.hidden ||
      (event.target instanceof Element && event.target.closest('input, textarea, [contenteditable], [data-terminal]'))) return;
    const { clientX, clientY } = event;
    timer = setTimeout(() => {
      fog.style.setProperty('--fog-x', `${clientX}px`);
      fog.style.setProperty('--fog-y', `${clientY}px`);
      fog.classList.add('is-visible');
    }, 800);
  }

  document.addEventListener('pointermove', waitForIdle, { passive: true });
  document.documentElement.addEventListener('pointerleave', clearFog);
  document.addEventListener('pointerdown', clearFog);
  document.addEventListener('keydown', clearFog);
  document.addEventListener('focusin', clearFog);
  document.addEventListener('scroll', clearFog, { capture: true, passive: true });
  document.addEventListener('visibilitychange', clearFog);
  window.addEventListener('blur', clearFog);
  mouse.addEventListener('change', clearFog);
  reducedMotion.addEventListener('change', clearFog);
</script>
