---
import { env } from 'cloudflare:workers';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { author } from '../config/author';
import { createServicesFromEnvironment } from '../http/context';
import SiteLayout from '../layouts/SiteLayout.astro';
const services = createServicesFromEnvironment(env);
const [projects, posts] = await Promise.all([services.projects.listPublic(), services.posts.listPublic({ limit: 3, offset: 0 })]);
---
<SiteLayout description={author.intro}><section class="hero"><div><p class="eyebrow">Independent developer / Shanghai</p><h1>Build.<br/>Explain.<br/>Refine.</h1></div><div class="hero-copy"><p>{author.intro}</p><a href={`mailto:${author.email}`}>{author.email} ↗</a></div></section><section class="section" aria-labelledby="projects-title"><div class="section-heading"><div><p class="eyebrow">01 / Selected work</p><h2 id="projects-title">Projects</h2></div><a href="/projects">View all ↗</a></div>{projects.length ? projects.slice(0,3).map((project,index)=><ProjectCard {project} {index}/>) : <p class="empty">Projects are being documented.</p>}</section><section class="section" aria-labelledby="writing-title"><div class="section-heading"><div><p class="eyebrow">02 / Field notes</p><h2 id="writing-title">Writing</h2></div><a href="/blog">View all ↗</a></div>{posts.items.length ? posts.items.map((post,index)=><PostCard {post} {index}/>) : <p class="empty">The first note is in progress.</p>}</section></SiteLayout>
