---
const title = 'termbook — MyDev';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1c1f1b" />
    <title>{title}</title>
    <style is:global>
      :root, html, body { width: 100%; height: 100%; margin: 0; padding: 0; overflow: hidden; background: #1c1f1b; }
      body { min-width: 0; }
      iframe { display: block; width: 100%; height: 100%; min-height: 100dvh; border: 0; }
    </style>
  </head>
  <body style="margin:0;width:100%;height:100%;overflow:hidden;background:#1c1f1b;">
    <iframe
      src="/terminal-blog/termvim.html"
      title="MyDev terminal blog"
      allow="clipboard-read; clipboard-write"
      style="display:block;width:100%;height:100%;border:0;"
    ></iframe>
  </body>
</html>
