---
import { env } from 'cloudflare:workers';
import PostCard from '../../components/PostCard.astro';
import { createServicesFromEnvironment } from '../../http/context';
import SiteLayout from '../../layouts/SiteLayout.astro';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1) || 1); const pageSize=10;
const result=await createServicesFromEnvironment(env).posts.listPublic({limit:pageSize,offset:(page-1)*pageSize}); const pages=Math.ceil(result.total/pageSize);
---
<SiteLayout title="Writing — MyDev" description="关于软件、产品打磨与公开构建的记录。">
  <header class="page-head"><p class="eyebrow">Journal / Field notes</p><h1>Writing</h1><p>技术选择、有价值的失败，以及值得长期保留的想法。</p></header>
  <section class="section">
    {result.items.length ? result.items.map((post,index)=><PostCard {post} index={(page-1)*pageSize+index}/>) : <p class="empty">这一页暂时没有已发布的文章。</p>}
    {pages > 1 && (
      <nav aria-label="Pagination">
        {page > 1 && <a href={`/blog?page=${page-1}`}>← Previous</a>}
        {page < pages && <a href={`/blog?page=${page+1}`}>Next →</a>}
      </nav>
    )}
  </section>
</SiteLayout>
