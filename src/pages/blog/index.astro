---
import { env } from 'cloudflare:workers';
import PostCard from '../../components/PostCard.astro';
import { StorageUnavailableError } from '../../domain/errors';
import { NO_STORE, PUBLIC_CACHE_CONTROL } from '../../http/response';
import { createServicesFromEnvironment } from '../../http/context';
import SiteLayout from '../../layouts/SiteLayout.astro';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1) || 1); const pageSize=10;
const services = createServicesFromEnvironment(env);
let unavailable = false;
let blogPage;
try {
  blogPage = await services.postQueries.listBlogPage({limit:pageSize,offset:(page-1)*pageSize});
  Astro.response.headers.set('Cache-Control', PUBLIC_CACHE_CONTROL);
} catch (error) {
  if (!(error instanceof StorageUnavailableError)) throw error;
  unavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', NO_STORE);
}
const result = blogPage ?? { items: [], total: 0 };
const groups = blogPage?.groups ?? [];
const groupNames = new Map(groups.map((group) => [group.id, group.name]));
const pages=Math.ceil(result.total/pageSize);
---
<SiteLayout title={unavailable ? 'Service unavailable — MyDev' : 'Writing — MyDev'} description="关于软件、产品打磨与公开构建的记录。">
  {unavailable ? (
    <header class="page-head"><p class="eyebrow">503 / Temporary fault</p><h1>Signal lost.</h1><p>文章服务暂时不可用，请稍后重试。</p></header>
  ) : <>
  <header class="page-head blog-index-head">
    <div>
      <h1>Writing</h1>
      <p>技术选择、有价值的失败，以及值得长期保留的想法。</p>
    </div>
    <p class="blog-count"><strong>{String(result.total).padStart(2, '0')}</strong><span>篇公开文章</span></p>
  </header>
  <section class="section blog-index" aria-labelledby="article-index-title">
    <h2 id="article-index-title" class="visually-hidden">文章索引</h2>
    {result.items.length ? <>
      <div class="post-table-head" aria-hidden="true"><span>发布日期</span><span>文章</span><span>阅读</span></div>
      <div class="post-table">{result.items.map((post,index)=><PostCard {post} groupName={post.groupId ? groupNames.get(post.groupId) : undefined} index={(page-1)*pageSize+index}/>)}</div>
    </> : <p class="empty">这一页暂时没有已发布的文章。</p>}
    {pages > 1 && (
      <nav class="blog-pagination" aria-label="文章分页">
        {page > 1 && <a href={`/blog?page=${page-1}`}>← 上一页</a>}
        <span>{page} / {pages}</span>
        {page < pages && <a href={`/blog?page=${page+1}`}>下一页 →</a>}
      </nav>
    )}
  </section>
  </>}
</SiteLayout>
