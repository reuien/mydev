---
import { env } from 'cloudflare:workers';
import { createServicesFromEnvironment } from '../../http/context';
import { renderMarkdown } from '../../lib/markdown';
import SiteLayout from '../../layouts/SiteLayout.astro';
const project=await createServicesFromEnvironment(env).projects.getPublicBySlug(Astro.params.slug??''); if(!project) Astro.response.status=404; const html=project?await renderMarkdown(project.bodyMarkdown):'';
---
<SiteLayout title={project?`${project.name} — MyDev`:'Project not found — MyDev'} description={project?.summary??'请求的项目不存在。'}>{project?<><header class="page-head"><p class="eyebrow">Project / {project.slug}</p><h1>{project.name}</h1><p>{project.summary}</p><ul class="tag-list">{project.techStack.map((item)=><li>{item}</li>)}</ul><p class="detail-meta">{project.codeUrl&&<a href={project.codeUrl}>Source ↗</a>}{project.demoUrl&&<a href={project.demoUrl}>Live demo ↗</a>}</p></header><article class="prose" set:html={html}/></>:<header class="page-head"><p class="eyebrow">404 / Missing</p><h1>Not found.</h1><p>这个项目已不可用。<a href="/projects">返回项目列表</a>。</p></header>}</SiteLayout>
