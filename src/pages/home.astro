---
import { env } from 'cloudflare:workers';
import SystemTopology from '../components/SystemTopology.astro';
import { author } from '../config/author';
import { createServicesFromEnvironment } from '../http/context';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/home.css';
const services = createServicesFromEnvironment(env);
const [projects, posts] = await Promise.all([services.projects.listPublic(), services.posts.listPublic({ limit: 1, offset: 0 })]);
const latestProject = projects[0];
const latestPost = posts.items[0];
---
<SiteLayout description={author.intro}>
  <div class="terminal-home">
    <div class="home-masthead">
      <span>THE PERSONAL WORKSPACE OF <strong>{author.name}</strong></span>
      <span><i aria-hidden="true"></i> 持续构建，持续记录</span>
    </div>

      <section class="os-workspace" aria-labelledby="home-title">
        <div class="workspace-copy">
          <p class="eyebrow"><span aria-hidden="true">01 /</span> IDEAS INTO SYSTEMS</p>
          <h1 id="home-title" lang="en">Build systems<br/>that explain<br/><span>themselves.</span></h1>
          <p class="workspace-intro">我是 {author.name}，一名热爱构建的开发者。<br class="intro-break"/>在这里，把想法写成代码，把探索留成文字。</p>
          <div class="workspace-actions">
            <a class="home-primary-action" href="/projects">探索项目 <span aria-hidden="true">↗</span></a>
            <a class="home-secondary-action" href="/blog">阅读文章 <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="topology-stage">
          <div class="stage-heading" aria-hidden="true"><span>THE LIVING SYSTEM</span><span>FIG. 001</span></div>
          <SystemTopology />
          <p class="topology-caption"><span class="interaction-hint">移动鼠标，探索节点之间的联系</span><span class="static-hint">节点相连，想法生长</span><span aria-hidden="true">↗</span></p>
        </div>
      </section>

      <aside class="system-status" role="region" aria-label="System status">
        <span class="focus-label">CURRENTLY EXPLORING</span>
        <ul>{author.focus.map((item) => <li>{item}</li>)}</ul>
        <span class="home-note">一点一滴，日益精进。</span>
      </aside>

    <nav class="system-commands" aria-label="System commands">
      <a href="/projects" aria-label="Open Projects"><span class="command-number">01</span><strong>PROJECTS</strong><small>把想法变成作品</small><span class="command-arrow" aria-hidden="true">↗</span></a>
      <a href="/blog" aria-label="Open Writing"><span class="command-number">02</span><strong>WRITING</strong><small>记录思考与发现</small><span class="command-arrow" aria-hidden="true">↗</span></a>
      <a href="/about" aria-label="Open About"><span class="command-number">03</span><strong>ABOUT</strong><small>关于我与我的探索</small><span class="command-arrow" aria-hidden="true">↗</span></a>
      <a href="/contact" aria-label="Open Guestbook"><span class="command-number">04</span><strong>GUESTBOOK</strong><small>留下一点你的想法</small><span class="command-arrow" aria-hidden="true">↗</span></a>
    </nav>

    <section class="activity-stream" aria-label="Activity stream">
      <header><div><p class="eyebrow">THE LATEST</p><h2>Along the way.</h2></div><p>最近的创作与记录</p></header>
      <div class="activity-grid">
        <a href={latestPost ? `/blog/${latestPost.slug}` : '/blog'}>
          <span class="activity-kind">WRITING <span>{latestPost?.publishedAt?.slice(0, 10) ?? 'NOTES & THOUGHTS'}</span></span><strong>{latestPost?.title ?? '下一段思考，正在酝酿。'}</strong><small>{latestPost?.excerpt ?? '关于技术、实践，以及探索过程中的一些小小发现。第一篇文章将在发布后出现在这里。'}</small><span class="activity-cta">阅读文章 <b aria-hidden="true">↗</b></span>
        </a>
        <a href={latestProject ? `/projects/${latestProject.slug}` : '/projects'}>
          <span class="activity-kind">PROJECT <span>BUILD & EXPERIMENT</span></span><strong>{latestProject?.name ?? '保持好奇，继续构建。'}</strong><small>{latestProject?.summary ?? '从一个小想法开始，让代码带来真实的变化。这里将记录正在构建的项目。'}</small><span class="activity-cta">探索项目 <b aria-hidden="true">↗</b></span>
        </a>
      </div>
    </section>
  </div>
</SiteLayout>
