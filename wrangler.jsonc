{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mydev",
  "compatibility_date": "2026-09-07",
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mydev",
      "database_id": "replace-with-cloudflare-d1-database-id",
      "migrations_dir": "migrations"
    }
  ]
}
