# Use a unique random value, for example: openssl rand -hex 32
# Author API token used by local publishing commands and the local Worker runtime.
AUTHOR_API_TOKEN=replace-with-random-64-character-secret
# The URL used by `pnpm publish --local ...`.
MYDEV_LOCAL_URL=http://127.0.0.1:4321
# The deployed Worker URL and its AUTHOR_API_TOKEN.
MYDEV_PRODUCTION_TOKEN=
MYDEV_PRODUCTION_URL=
# Canonical URL used for public links and metadata.
PUBLIC_SITE_URL=http://127.0.0.1:4321
